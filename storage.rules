rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Session material cover images — authenticated admins/students can read;
    // only authenticated users can upload/update/delete under this prefix.
    match /session_materials/{materialId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
